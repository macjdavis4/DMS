# --- Application -------------------------------------------------------------
NODE_ENV=development
# Public origin for the app (used for redirects, cookies, etc.)
NEXTAUTH_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------
# Use a strong password in production. The docker-compose stack sets these.
DATABASE_URL=postgresql://dms:dms_dev_password@localhost:5432/dms?schema=public

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-openssl-rand-base64-48
# Optional: comma-separated list of trusted origins for CSRF (defaults to NEXTAUTH_URL)
AUTH_TRUSTED_HOSTS=

# Initial admin (only used by `pnpm db:seed`, never in production after first run)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeImmediately!1
SEED_ADMIN_NAME=Administrator

# --- File storage ------------------------------------------------------------
# Where uploaded data cards, photos, and attachments are persisted.
# This path must be writable and ideally a mounted volume in production.
STORAGE_ROOT=./storage
# Max upload size in bytes (default 15 MB)
MAX_UPLOAD_BYTES=15728640

# --- Google Vision (OCR for handwritten data cards) --------------------------
# Path to service-account JSON key file with Vision API enabled.
# Leave blank to disable OCR (uploads still work, OCR step is skipped).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Backups -----------------------------------------------------------------
# Directory for nightly pg_dump + file-storage snapshots
BACKUP_DIR=./backups
# How many daily snapshots to retain (older ones are pruned)
BACKUP_RETENTION_DAYS=30

# --- Rate limiting -----------------------------------------------------------
# Failed-login lockout: N attempts within WINDOW_MINUTES triggers temporary lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
