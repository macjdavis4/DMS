// Forklift Dealer Management System — data model
//
// Conventions:
//   * Money is stored as Decimal(12, 2) — never Float
//   * Timestamps are timestamptz, default now(), and auto-updated where relevant
//   * Soft-delete via deletedAt is used for inventory and customers to preserve audit trail
//   * Every mutable entity participates in the AuditLog table via app-level hooks

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
// Users & auth
// ──────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  SALES
  SERVICE
  READ_ONLY
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole  @default(READ_ONLY)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  mustChangePwd Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions       Session[]
  auditLogs      AuditLog[]
  createdSales   Sale[]      @relation("SalesCreatedBy")
  uploaded       Attachment[]

  @@index([email])
  @@index([isActive])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Inventory: forklifts
// ──────────────────────────────────────────────────────────────────────────────

enum InventoryStatus {
  AVAILABLE
  ON_HOLD
  IN_SERVICE
  SOLD
  ARCHIVED
}

enum Condition {
  NEW
  USED
}

enum FuelType {
  ELECTRIC
  LP_GAS
  DIESEL
  GASOLINE
  DUAL_FUEL
  HYDROGEN
}

enum TireType {
  CUSHION
  PNEUMATIC
  SOLID_PNEUMATIC
}

enum ForkliftClass {
  CLASS_I    // Electric Motor Rider, Counterbalanced
  CLASS_II   // Electric Motor Narrow Aisle
  CLASS_III  // Electric Motor Hand or Hand/Rider
  CLASS_IV   // Internal Combustion, Cushion Tires
  CLASS_V    // Internal Combustion, Pneumatic Tires
  CLASS_VI   // Electric/IC Tractors
  CLASS_VII  // Rough Terrain
}

model Forklift {
  id              String           @id @default(cuid())
  stockNumber     String           @unique
  status          InventoryStatus  @default(AVAILABLE)
  condition       Condition
  make            String
  model           String
  year            Int?
  serialNumber    String?          @unique
  fuelType        FuelType?
  forkliftClass   ForkliftClass?
  capacityLbs     Int?
  mastType        String?
  mastLoweredIn   Int?             // mast height lowered (inches)
  mastRaisedIn    Int?             // max fork height (inches)
  sideShift       Boolean          @default(false)
  attachments     String?          // freeform: clamps, rotators, etc.
  hours           Int?
  tireType        TireType?
  batteryVolts    Int?
  color           String?
  yardLocation    String?

  acquisitionDate DateTime?
  acquisitionCost Decimal?         @db.Decimal(12, 2)
  listPrice       Decimal?         @db.Decimal(12, 2)

  description     String?
  internalNotes   String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  photos          Attachment[]
  sale            Sale?

  @@index([status])
  @@index([condition])
  @@index([make, model])
  @@index([deletedAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Customers
// ──────────────────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  // For business customers, company is set; for individuals, leave blank.
  company   String?
  firstName String
  lastName  String
  email     String?
  phone     String?
  address1  String?
  address2  String?
  city      String?
  state     String?
  zip       String?
  notes     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sales     Sale[]

  @@index([company])
  @@index([lastName, firstName])
  @@index([deletedAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Sales (current and historical)
// ──────────────────────────────────────────────────────────────────────────────

enum SaleType {
  CASH
  FINANCED
  LEASED
  RENTAL
  TRADE_IN
}

model Sale {
  id            String   @id @default(cuid())
  // Each forklift can be sold exactly once (status flips to SOLD on creation).
  // For unit-resale scenarios, archive the forklift and create a new inventory record.
  forkliftId    String   @unique
  forklift      Forklift @relation(fields: [forkliftId], references: [id])

  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])

  saleDate      DateTime
  salePrice     Decimal  @db.Decimal(12, 2)
  saleType      SaleType @default(CASH)
  invoiceNumber String?  @unique
  notes         String?

  // For historical sales entered via OCR'd hand-written data cards
  isHistorical  Boolean  @default(false)
  dataCardId    String?  @unique
  dataCard      Attachment? @relation("SaleDataCard", fields: [dataCardId], references: [id])

  createdById   String?
  createdBy     User?    @relation("SalesCreatedBy", fields: [createdById], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([saleDate])
  @@index([customerId])
  @@index([isHistorical])
}

// ──────────────────────────────────────────────────────────────────────────────
// File attachments (photos, data cards, documents)
// ──────────────────────────────────────────────────────────────────────────────

enum AttachmentKind {
  PHOTO
  DATA_CARD
  INVOICE
  DOCUMENT
  OTHER
}

model Attachment {
  id           String         @id @default(cuid())
  kind         AttachmentKind @default(PHOTO)
  // Storage path relative to STORAGE_ROOT. Never an absolute path.
  storagePath  String
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String         // for integrity verification & dedup

  // For DATA_CARD: extracted text + confidence after OCR processing
  ocrText       String?
  ocrConfidence Float?
  ocrProcessedAt DateTime?

  forkliftId   String?
  forklift     Forklift? @relation(fields: [forkliftId], references: [id], onDelete: SetNull)

  // Inverse of Sale.dataCard
  saleDataCard Sale?     @relation("SaleDataCard")

  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id])

  createdAt    DateTime  @default(now())

  @@index([forkliftId])
  @@index([kind])
  @@index([sha256])
}

// ──────────────────────────────────────────────────────────────────────────────
// Audit log — every mutating action against business data is logged
// ──────────────────────────────────────────────────────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGE
  EXPORT
  UPLOAD
  OCR
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String      // e.g. "Forklift", "Sale", "User"
  entityId   String?
  changes    Json?       // diff: { before, after } or { fields: {...} }
  ipAddress  String?
  userAgent  String?

  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
